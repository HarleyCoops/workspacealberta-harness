{
  "name": "@workspacealberta/wa-client-ui-user-questions",
  "description": "Web ask_user_question feature: host tool mount plus composer-takeover question UI",
  "version": "0.1.0-rc.8",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/ui-user-questions"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@workspacealberta/wa-client-locale",
        "@workspacealberta/wa-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "dependencies": {
    "clsx": "^2.0.0"
  },
  "peerDependencies": {
    "@workspacealberta/cordis": "workspace:^",
    "@workspacealberta/wa-api-remotes": "workspace:^",
    "@workspacealberta/wa-client-locale": "workspace:^",
    "@workspacealberta/wa-invariants": "workspace:^",
    "@workspacealberta/wa-client-runtime": "workspace:^",
    "@workspacealberta/wa-client-ui-conversation": "workspace:^"
  },
  "devDependencies": {
    "@workspacealberta/cordis": "workspace:^",
    "@workspacealberta/wa-agent": "workspace:^",
    "@workspacealberta/wa-api-remotes": "workspace:^",
    "@workspacealberta/wa-client-locale": "workspace:^",
    "@workspacealberta/wa-invariants": "workspace:^",
    "@workspacealberta/wa-system-prompt": "workspace:^",
    "@workspacealberta/wa-tools": "workspace:^",
    "@workspacealberta/wa-user-questions": "workspace:^",
    "@types/react": "~18.3.1",
    "@workspacealberta/wa-client-ui-primitives": "workspace:^",
    "@workspacealberta/wa-client-ui-slots": "workspace:^",
    "react": "^18.2.0",
    "@workspacealberta/wa-client-runtime": "workspace:^",
    "@workspacealberta/wa-client-ui-conversation": "workspace:^",
    "@workspacealberta/wa-client-connection": "workspace:^"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
