{
  "name": "@workspacealberta/wa-compaction-basic",
  "description": "Token-meter-driven compaction policy and LLM summarization backend for the DeepSeek Harness",
  "version": "0.1.0-rc.8",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/compaction/compaction-basic"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@workspacealberta/wa-agent": "workspace:^",
    "@workspacealberta/wa-compaction": "workspace:^",
    "@workspacealberta/wa-commands": "workspace:^",
    "@workspacealberta/wa-invariants": "workspace:^",
    "@workspacealberta/wa-llm": "workspace:^",
    "@workspacealberta/wa-session": "workspace:^",
    "@workspacealberta/wa-token-meter": "workspace:^",
    "@workspacealberta/wa-compaction-tool-result-pruner": "workspace:^",
    "@workspacealberta/cordis": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@workspacealberta/wa-compaction-tool-result-pruner": {
      "optional": true
    }
  },
  "dependencies": {
    "@workspacealberta/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@workspacealberta/cordis-plugin-include": "workspace:^",
    "@workspacealberta/cordis-plugin-loader": "workspace:^",
    "@workspacealberta/wa-agent": "workspace:^",
    "@workspacealberta/wa-agent-loop": "workspace:^",
    "@workspacealberta/wa-agent-loop-testkit": "workspace:^",
    "@workspacealberta/wa-compaction": "workspace:^",
    "@workspacealberta/wa-commands": "workspace:^",
    "@workspacealberta/wa-invariants": "workspace:^",
    "@workspacealberta/wa-llm": "workspace:^",
    "@workspacealberta/wa-llm-retry": "workspace:^",
    "@workspacealberta/wa-session": "workspace:^",
    "@workspacealberta/wa-token-meter": "workspace:^",
    "@workspacealberta/wa-compaction-tool-result-pruner": "workspace:^",
    "@workspacealberta/wa-tools": "workspace:^",
    "@workspacealberta/cordis": "workspace:^"
  }
}
